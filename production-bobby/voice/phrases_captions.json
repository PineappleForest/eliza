{
 "phrases": [
  {
   "text": "In Edinburgh,",
   "start": 0.07,
   "end": 0.81
  },
  {
   "text": "a little dog refused to leave his best friend.",
   "start": 1.06,
   "end": 3.5
  },
  {
   "text": "In 1858,",
   "start": 4.11,
   "end": 5.18
  },
  {
   "text": "his owner,",
   "start": 5.39,
   "end": 6.326
  },
  {
   "text": "John Gray, died.",
   "start": 6.326,
   "end": 7.54
  },
  {
   "text": "Bobby followed him to the churchyard, and stayed.",
   "start": 8.13,
   "end": 10.61
  },
  {
   "text": "Through rain and snow,",
   "start": 11.19,
   "end": 12.43
  },
  {
   "text": "he is said to have kept watch by the grave for 14 years.",
   "start": 12.49,
   "end": 16.09
  },
  {
   "text": "The people of Edinburgh looked after him.",
   "start": 16.6,
   "end": 18.24
  },
  {
   "text": "The Lord Provost even paid for his licence.",
   "start": 18.66,
   "end": 20.76
  },
  {
   "text": "Today, he has a statue.",
   "start": 21.28,
   "end": 22.83
  },
  {
   "text": "Everyone deserves someone who stays.",
   "start": 23.4,
   "end": 25.2
  },
  {
   "text": "That's why we made Feeloy.",
   "start": 25.67,
   "end": 27.02
  },
  {
   "text": "Jenny never leaves.",
   "start": 27.44,
   "end": 28.67
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 29.1,
   "end": 30.49
  }
 ]
}