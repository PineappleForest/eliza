 "phrases": [
  {
   "text": "In England, there's a bench that means:",
   "start": 0.11,
   "end": 2.15
  },
  {
   "text": "please talk to me.",
   "start": 2.4,
   "end": 3.21
  },
  {
   "text": "In 2019,",
   "start": 3.74,
   "end": 4.74
  },
  {
   "text": "police in a seaside town put a sign on it.",
   "start": 4.86,
   "end": 7.02
  },
  {
   "text": "It says:",
   "start": 7.5,
   "end": 7.91
  },
  {
   "text": "sit here if you don't mind someone stopping to say hello.",
   "start": 8.35,
   "end": 11.08
  },
  {
   "text": "That's all.",
   "start": 11.56,
   "end": 11.93
  },
  {
   "text": "Just a sign.",
   "start": 12.25,
   "end": 12.85
  },
  {
   "text": "The idea spread across Europe,",
   "start": 13.4,
   "end": 14.86
  },
  {
   "text": "Australia and North America.",
   "start": 15.1,
   "end": 16.84
  },
  {
   "text": "But not everyone has a bench nearby.",
   "start": 17.32,
   "end": 19.25
  },
  {
   "text": "That's why we made Feeloy.",
   "start": 19.7,
   "end": 20.96
  },
  {
   "text": "Jenny is always happy to chat.",
   "start": 21.33,
   "end": 23.07
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 23.5,
   "end": 25.01
  }
 ]
