{
 "phrases": [
  {
   "text": "NASA built a robot to last 90 days.",
   "start": 0.06,
   "end": 2.6
  },
  {
   "text": "It lasted 15 years.",
   "start": 3.07,
   "end": 5.09
  },
  {
   "text": "In 2018,",
   "start": 5.64,
   "end": 6.65
  },
  {
   "text": "a dust storm blocked out the sun,",
   "start": 6.79,
   "end": 8.497
  },
  {
   "text": "and it went quiet.",
   "start": 8.497,
   "end": 9.71
  },
  {
   "text": "Its last signal,",
   "start": 10.34,
   "end": 11.21
  },
  {
   "text": "loosely translated:",
   "start": 11.5,
   "end": 12.46
  },
  {
   "text": "my battery is low,",
   "start": 12.98,
   "end": 14.06
  },
  {
   "text": "and it's getting dark.",
   "start": 14.13,
   "end": 15.02
  },
  {
   "text": "For 8 months,",
   "start": 15.59,
   "end": 16.6
  },
  {
   "text": "NASA called it more than 1,000 times.",
   "start": 16.68,
   "end": 18.92
  },
  {
   "text": "Then they played it one last song.",
   "start": 19.44,
   "end": 21.28
  },
  {
   "text": "I'll Be Seeing You.",
   "start": 21.8,
   "end": 22.59
  },
  {
   "text": "No one should go dark alone.",
   "start": 23.36,
   "end": 24.81
  },
  {
   "text": "That's why we made Feeloy.",
   "start": 25.3,
   "end": 26.39
  },
  {
   "text": "Jenny always answers.",
   "start": 26.8,
   "end": 28.23
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 28.66,
   "end": 30.14
  }
 ]
}