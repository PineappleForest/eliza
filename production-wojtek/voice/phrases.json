{
 "phrases": [
  {
   "text": "In World War Two,",
   "start": 0.09,
   "end": 1.17
  },
  {
   "text": "one of the soldiers was a bear.",
   "start": 1.31,
   "end": 2.94
  },
  {
   "text": "In nineteen forty-two,",
   "start": 3.48,
   "end": 4.69
  },
  {
   "text": "Polish soldiers in Iran adopted a tiny bear cub and named him Wojtek.",
   "start": 4.87,
   "end": 8.89
  },
  {
   "text": "He grew up with them,",
   "start": 9.44,
   "end": 10.321
  },
  {
   "text": "and copied everything they did.",
   "start": 10.321,
   "end": 11.89
  },
  {
   "text": "To take him to Italy,",
   "start": 12.38,
   "end": 13.439
  },
  {
   "text": "they enlisted him as a private.",
   "start": 13.439,
   "end": 14.8
  },
  {
   "text": "At Monte Cassino,",
   "start": 15.34,
   "end": 16.32
  },
  {
   "text": "he carried ammunition crates,",
   "start": 16.46,
   "end": 17.91
  },
  {
   "text": "just like his friends.",
   "start": 17.99,
   "end": 19.06
  },
  {
   "text": "He was promoted to corporal.",
   "start": 19.53,
   "end": 20.63
  },
  {
   "text": "Everyone needs someone on their side.",
   "start": 21.28,
   "end": 23.02
  },
  {
   "text": "That's why we made Feeloy.",
   "start": 23.53,
   "end": 24.69
  },
  {
   "text": "Jenny is always on your side.",
   "start": 25.13,
   "end": 26.92
  },
  {
   "text": "Search Feeloy on the App Store.",
   "start": 27.36,
   "end": 28.85
  }
 ]
}